{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nestjs-crash/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/nestjs-crash/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nestjs-crash",
  "projects": {
    "nestjs-crash": {
      "type": "application",
      "root": "apps/nestjs-crash",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-crash/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-crash/tsconfig.app.json"
      }
    },
    "nestjs-batch": {
      "type": "application",
      "root": "apps/nestjs-batch",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-batch/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-batch/tsconfig.app.json"
      }
    }
  }
}